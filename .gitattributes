# Preserve the supplied program requirements byte-for-byte. Its seven-equals
# heading underline is intentional prose, not a Git conflict marker.
docs/superpowers/specs/2026-09-17-engineering-program-requirements.md -text conflict-marker-size=80

# Frozen benchmark hashes use the same LF bytes on every checkout platform.
scripts/bench/specialist_fixtures/**/*.json text eol=lf
scripts/bench/large_manifest.json text eol=lf

# Provenance, compiler and evaluation fingerprints bind the checked-in bytes.
crates/davinci-coding-agent/design-resources/** text eol=lf
crates/davinci-coding-agent/design-ui/host/** text eol=lf
crates/davinci-coding-agent/design-ui/package-lock.json text eol=lf
docs/evals/design/** text eol=lf

# Codemode runtime admission hashes must match native-platform checkout bytes.
crates/davinci-coding-agent/codemode-host/*.mjs text eol=lf
crates/davinci-coding-agent/codemode-host/package-lock.json text eol=lf
crates/davinci-coding-agent/src/codemode_host/assets-manifest.json text eol=lf
# Upstream notices retain the exact collected bytes, including whitespace.
crates/davinci-coding-agent/codemode-host/licenses/** -text
