{
  "name": "isomorphic-pkg",
  "version": "2.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./feature": {
      "types": "./dist/feature.d.ts",
      "browser": "./dist/feature.browser.js",
      "node": "./dist/feature.node.js"
    },
    "./sub/*": "./dist/sub/*.js"
  }
}